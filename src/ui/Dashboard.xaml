<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBrush" Color="#F2F5F8"/><SolidColorBrush x:Key="SideBrush" Color="#E9EFF3"/><SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/><SolidColorBrush x:Key="RaisedBrush" Color="#F4F7FA"/><SolidColorBrush x:Key="LineBrush" Color="#DFE7ED"/><SolidColorBrush x:Key="MutedBrush" Color="#637383"/><SolidColorBrush x:Key="AccentBrush" Color="#008C82"/><SolidColorBrush x:Key="AccentSoftBrush" Color="#DDF3EF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="PageBrush" Color="#11171F"/><SolidColorBrush x:Key="SideBrush" Color="#0D131B"/><SolidColorBrush x:Key="CardBrush" Color="#1A232E"/><SolidColorBrush x:Key="RaisedBrush" Color="#202C39"/><SolidColorBrush x:Key="LineBrush" Color="#2B3948"/><SolidColorBrush x:Key="MutedBrush" Color="#91A2B4"/><SolidColorBrush x:Key="AccentBrush" Color="#43D2BF"/><SolidColorBrush x:Key="AccentSoftBrush" Color="#163D3B"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/></Style>
      <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/><Setter Property="FontSize" Value="12"/></Style>
      <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="FontSize" Value="30"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Bahnschrift"/></Style>
      <DataTemplate x:Key="AppTemplate">
        <Grid x:Name="AppRow" Height="58" Padding="14,0" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,0,1" ColumnSpacing="8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="160"/><ColumnDefinition Width="98"/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="76"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource RaisedBrush}"><Grid><FontIcon x:Name="Avatar" Glyph="&#xE737;" FontSize="16" Opacity="0.45"/><Image x:Name="AppIcon" Width="24" Height="24"/></Grid></Border><TextBlock x:Name="AppName" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="210"/></StackPanel>
          <TextBlock x:Name="RowTotal" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" FontFamily="Bahnschrift"/>
          <TextBlock x:Name="RowLeft" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/><TextBlock x:Name="RowRight" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/><TextBlock x:Name="RowMiddle" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/><TextBlock x:Name="RowSide1" Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/><TextBlock x:Name="RowSide2" Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/><TextBlock x:Name="RowWheel" Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource MutedBrush}"/>
          <StackPanel Grid.Column="8" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="5"><TextBlock x:Name="RowShare" FontSize="11" HorizontalAlignment="Right" Foreground="{ThemeResource MutedBrush}"/><Border Width="64" Height="3" Background="{ThemeResource LineBrush}" CornerRadius="1.5"><Border x:Name="ShareFill" HorizontalAlignment="Left" Width="0" Background="{ThemeResource AccentBrush}" CornerRadius="1.5"/></Border></StackPanel>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Height="48" Background="{ThemeResource PageBrush}">
    <Border Width="178" HorizontalAlignment="Left" Background="{ThemeResource SideBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0"/>
    <StackPanel x:Name="TitleBrand" Orientation="Horizontal" Spacing="9" Margin="24,0,0,0" VerticalAlignment="Center"><FontIcon Glyph="&#xE962;" FontSize="21" Foreground="{ThemeResource AccentBrush}"/><TextBlock Text="Click Stats" FontSize="19" FontWeight="SemiBold"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1">
  <Grid.ColumnDefinitions><ColumnDefinition Width="178"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.RowSpan="4" Background="{ThemeResource SideBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,12,16,20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
        <ListView x:Name="Navigation" SelectedIndex="0" SelectionMode="Single" Background="Transparent">
          <ListViewItem Padding="12,13"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE9D9;" FontSize="17"/><TextBlock Text="统计概览" FontSize="13"/></StackPanel></ListViewItem>
          <ListViewItem Padding="12,13"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE71D;" FontSize="17"/><TextBlock Text="应用统计" FontSize="13"/></StackPanel></ListViewItem>
          <ListViewItem Padding="12,13"><StackPanel Orientation="Horizontal" Spacing="11"><FontIcon Glyph="&#xE713;" FontSize="17"/><TextBlock Text="设置" FontSize="13"/></StackPanel></ListViewItem>
        </ListView>
      </StackPanel>
      <StackPanel Grid.Row="2" Spacing="10" Margin="8,0"><StackPanel Orientation="Horizontal" Spacing="7"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{ThemeResource AccentBrush}"/><TextBlock x:Name="StatusLabel" Text="正在连接" FontSize="11"/></StackPanel><TextBlock Text="本地统计 · v0.3.5" Style="{StaticResource Muted}" FontSize="10"/></StackPanel>
    </Grid>
  </Border>
  <Grid Grid.Column="1" Padding="28,6,28,14" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ToggleButton x:Name="PauseButton" Grid.Column="1" Content="暂停统计" VerticalAlignment="Center" Padding="14,8"/><Button x:Name="ExportButton" Grid.Column="2" VerticalAlignment="Center" Padding="14,8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="13"/><TextBlock Text="导出" FontSize="12"/></StackPanel></Button></Grid>
  <StackPanel Grid.Column="1" Grid.Row="1" Padding="28,0,28,16" Spacing="12">
    <InfoBar x:Name="PermissionBanner" IsOpen="False" IsClosable="False" Severity="Warning" Title="采集器尚未以管理员权限运行" Message="普通应用可正常统计；管理员运行的游戏或程序可能漏记点击。" CornerRadius="10">
      <InfoBar.ActionButton><Button x:Name="BannerElevateButton" IsEnabled="False" AutomationProperties.Name="以管理员权限重启采集器"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xEA18;" FontSize="14"/><TextBlock Text="提升采集权限"/></StackPanel></Button></InfoBar.ActionButton>
    </InfoBar>
    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Informational"/>

  </StackPanel>
  <ScrollViewer x:Name="MainScroll" Grid.Column="1" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="OverviewPage" Padding="28,0,28,20" Spacing="16">
      <Border x:Name="PulseCard" Style="{StaticResource Card}" Background="{ThemeResource AccentSoftBrush}" ToolTipService.ToolTip="APM 只计算鼠标五键按下，不含键盘与滚轮。窗口按分钟滚动；重启采集器后重新热身。">
        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="8" VerticalAlignment="Center">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="实时活动" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center"/><Border Background="{ThemeResource CardBrush}" CornerRadius="8" Padding="8,3"><TextBlock x:Name="PulseBadge" Text="正在连接" FontSize="10" Foreground="{ThemeResource AccentBrush}"/></Border><StackPanel x:Name="PulseBars" Orientation="Horizontal" Spacing="3" Height="22"/></StackPanel><Button x:Name="SpeedTestButton" Grid.Column="1" VerticalAlignment="Center" Padding="12,6" ToolTipService.ToolTip="测试 1 秒或 3 秒内的左键 / 右键点击速度"><StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE916;" FontSize="13"/><TextBlock Text="手速测试" FontSize="12"/></StackPanel></Button></Grid>
            <TextBlock x:Name="PulseHeadline" Text="正在连接采集器。" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="PulsePace" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock x:Name="PulseCoverage" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
          </StackPanel>
          <Grid Grid.Column="1" ColumnSpacing="10" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{ThemeResource CardBrush}" CornerRadius="12" Padding="14"><StackPanel Spacing="8"><TextBlock Text="近 30 分钟" Style="{StaticResource Muted}"/><TextBlock x:Name="Pulse30" Text="—" FontSize="25" FontWeight="SemiBold" FontFamily="Bahnschrift"/><TextBlock Text="次点击" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
            <Border Grid.Column="1" Background="{ThemeResource CardBrush}" CornerRadius="12" Padding="14"><StackPanel Spacing="8"><TextBlock Text="近 1 小时" Style="{StaticResource Muted}"/><TextBlock x:Name="Pulse60" Text="—" FontSize="25" FontWeight="SemiBold" FontFamily="Bahnschrift"/><TextBlock Text="次点击" Style="{StaticResource Muted}" FontSize="10"/></StackPanel></Border>
          </Grid>
        </Grid>
      </Border>
      <StackPanel x:Name="DailyStatistics" Spacing="16">
        <StackPanel Spacing="12"><TextBlock Text="日期统计" FontSize="17" FontWeight="SemiBold"/><Border x:Name="OverviewDateHost">
    <Grid x:Name="DateToolbar" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CalendarDatePicker x:Name="DatePicker" DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"/><Button x:Name="TodayButton" Grid.Column="1" Content="今天"/><StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE787;" FontSize="12" Foreground="{ThemeResource MutedBrush}"/><TextBlock x:Name="DateHint" Style="{StaticResource Muted}" Text="按本地日期统计"/></StackPanel></Grid>
        </Border></StackPanel>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel Spacing="9"><TextBlock Text="当日点击" Style="{StaticResource Muted}"/><TextBlock x:Name="TotalClicks" Text="—" Style="{StaticResource Metric}"/><TextBlock x:Name="DayComparison" Text="正在读取" FontSize="11" Foreground="{ThemeResource AccentBrush}"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="9"><TextBlock Text="当日滚轮 / 格" Style="{StaticResource Muted}"/><TextBlock x:Name="WheelCount" Text="—" Style="{StaticResource Metric}"/><TextBlock x:Name="WheelDetail" FontSize="11" Style="{StaticResource Muted}"/></StackPanel></Border>
      </Grid>
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="点击趋势" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="TrendDescription" Style="{StaticResource Muted}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"><ComboBox x:Name="TrendFilter" SelectedIndex="0" Width="105"><ComboBoxItem Content="全部点击"/><ComboBoxItem Content="左键"/><ComboBoxItem Content="右键"/><ComboBoxItem Content="中键"/><ComboBoxItem Content="侧键 1"/><ComboBoxItem Content="侧键 2"/></ComboBox><ComboBox x:Name="RangePicker" SelectedIndex="0" Width="105"><ComboBoxItem Content="近 7 天"/><ComboBoxItem Content="近 30 天"/><ComboBoxItem Content="近 90 天"/></ComboBox></StackPanel></Grid><Canvas x:Name="TrendChart" Height="206" HorizontalAlignment="Stretch" AutomationProperties.Name="每日点击趋势面积图"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock x:Name="AverageLabel" Text="近 7 天日均" Style="{StaticResource Muted}" VerticalAlignment="Center"/><TextBlock x:Name="AverageClicks" Text="—" FontSize="17" FontWeight="SemiBold" FontFamily="Bahnschrift" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="PeakLabel" Grid.Column="1" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid><Grid><TextBlock x:Name="PeriodTotal" FontSize="12" Foreground="{ThemeResource AccentBrush}"/><TextBlock x:Name="PeriodDates" FontSize="11" Foreground="{ThemeResource MutedBrush}" HorizontalAlignment="Right"/></Grid></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="17"><Grid><TextBlock Text="当日按键分布" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="次数 / 占比" HorizontalAlignment="Right" Style="{StaticResource Muted}" FontSize="10"/></Grid><StackPanel x:Name="ButtonLegend" Spacing="15"/></StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><Grid><TextBlock Text="应用点击排行" FontSize="16" FontWeight="SemiBold"/><Button x:Name="AllAppsButton" HorizontalAlignment="Right" Content="查看全部应用  →" FontSize="11" Padding="10,4"/></Grid><StackPanel x:Name="TopApps" Spacing="12"/></StackPanel></Border>
      </StackPanel>
      <Border x:Name="LifetimeCard" Style="{StaticResource Card}">
        <StackPanel Spacing="16">
          <StackPanel Spacing="4"><TextBlock Text="累计用量" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="LifetimeSince" Text="全部历史记录，不受日期筛选影响" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
          <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="5"><TextBlock Text="总点击" Style="{StaticResource Muted}"/><TextBlock x:Name="LifetimeTotal" Text="—" FontSize="28" FontWeight="SemiBold" FontFamily="Bahnschrift"/></StackPanel>
            <Grid x:Name="LifetimeButtons" Grid.Column="1" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions></Grid>
          </Grid>
          <TextBlock Text="全部历史 · 合并所有鼠标 · 已记录用量不代表剩余寿命" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
  <Grid x:Name="ApplicationsPage" Grid.Column="1" Grid.Row="2" Padding="28,0,28,18" Visibility="Collapsed" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="ApplicationsDateHost"/>
    <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AppSearch" PlaceholderText="搜索应用名称或路径"/><ComboBox x:Name="SortPicker" Grid.Column="1" SelectedIndex="0" Width="150"><ComboBoxItem Content="按点击次数"/><ComboBoxItem Content="按应用名称"/><ComboBoxItem Content="按滚轮使用"/></ComboBox></Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Padding="14,0,26,0" ColumnSpacing="8" Background="{ThemeResource RaisedBrush}" CornerRadius="14,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="160"/><ColumnDefinition Width="98"/><ColumnDefinition Width="66"/><ColumnDefinition Width="66"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="76"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="应用" VerticalAlignment="Center" Style="{StaticResource Muted}"/><TextBlock Grid.Column="1" Text="总点击" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="左键" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/><TextBlock Grid.Column="3" Text="右键" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/><TextBlock Grid.Column="4" Text="中键" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/><TextBlock Grid.Column="5" Text="侧 1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/><TextBlock Grid.Column="6" Text="侧 2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/><TextBlock Grid.Column="7" Text="滚轮格数" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/><TextBlock Grid.Column="8" Text="占比" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Muted}"/></Grid>
      <ListView x:Name="AppList" Grid.Row="1" ItemTemplate="{StaticResource AppTemplate}" SelectionMode="Single" IsItemClickEnabled="True" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel CacheLength="1"/></ItemsPanelTemplate></ListView.ItemsPanel>
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="58"/></Style></ListView.ItemContainerStyle>
        <ListView.ItemContainerTransitions><TransitionCollection/></ListView.ItemContainerTransitions>
      </ListView>
      <TextBlock x:Name="AppEmpty" Grid.Row="1" Text="所选日期暂无点击记录。" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}" Visibility="Collapsed"/>
    </Grid></Border>
    <Grid Grid.Row="3"><TextBlock x:Name="AppListSummary" Style="{StaticResource Muted}"/><TextBlock Text="点击应用查看明细  ↗" HorizontalAlignment="Right" Style="{StaticResource Muted}"/></Grid>
  </Grid>
  <ScrollViewer x:Name="SettingsPage" Grid.Column="1" Grid.Row="2" Padding="28,0,28,18" Visibility="Collapsed"><StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left"><Border Style="{StaticResource Card}"><StackPanel Spacing="18"><TextBlock Text="采集设置" FontSize="17" FontWeight="SemiBold"/><StackPanel Spacing="10"><TextBlock Text="登录自启权限" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="10"><ComboBox x:Name="StartupModePicker" SelectedIndex="0" Width="210"><ComboBoxItem Content="关闭登录自启"/><ComboBoxItem Content="普通权限登录自启"/><ComboBoxItem Content="管理员权限登录自启"/></ComboBox><Button x:Name="SaveStartupButton" Content="应用设置"/></StackPanel><TextBlock x:Name="StartupHint" Text="正在读取登录自启配置…" TextWrapping="Wrap" Style="{StaticResource Muted}"/><TextBlock Text="管理员自启首次设置需要 UAC 授权，之后登录自动以管理员权限采集；切换或关闭时也可能需要授权。界面以普通权限运行。" TextWrapping="Wrap" Style="{StaticResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="12"><Button x:Name="FolderButton" Content="打开数据目录"/><Button x:Name="DiagnoseButton" Content="保存采集诊断"/></StackPanel><TextBlock x:Name="PermissionHint" Text="正在检查采集权限" TextWrapping="WrapWholeWords"/><Button x:Name="ElevateButton" Content="以管理员权限重启采集器"/><TextBlock Text="此按钮只提升本次采集权限。若希望重启后保持管理员权限，请在上方选择“管理员权限登录自启”并应用设置。" Style="{StaticResource Muted}" TextWrapping="WrapWholeWords"/><TextBlock Text="游戏点击漏记时，可保存两路采集的按键汇总，帮助定位问题。" Style="{StaticResource Muted}" TextWrapping="WrapWholeWords"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="数据管理" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ClearStatisticsHint" Text="删除全部日期、全部应用的统计记录，确认后执行。" TextWrapping="WrapWholeWords" Style="{StaticResource Muted}"/><Button x:Name="ClearStatisticsButton" Content="清空统计数据" Foreground="#DC5864"/><TextBlock Text="清空后保留登录自启和暂停设置。" TextWrapping="WrapWholeWords" Style="{StaticResource Muted}" FontSize="11"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="隐私与统计说明" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="所有统计保存在本机。记录日期、应用和各按键汇总，不记录鼠标轨迹、窗口标题或键盘内容。" TextWrapping="WrapWholeWords"/><TextBlock Text="按下记一次，双击记两次。任务栏操作单独归类，其余按前台应用统计；滚轮按 120 增量折算一格。" TextWrapping="WrapWholeWords" Style="{StaticResource Muted}"/><TextBlock Text="关闭面板后继续后台统计；在系统托盘选择“退出”可停止采集并关闭面板。" TextWrapping="WrapWholeWords" Style="{StaticResource Muted}"/></StackPanel></Border></StackPanel></ScrollViewer>
  <Grid Grid.Column="1" Grid.Row="3" Padding="28,0,28,14"><TextBlock x:Name="RefreshLabel" Text="正在读取统计数据…" Style="{StaticResource Muted}" FontSize="10"/><TextBlock Text="本地数据" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right"/></Grid>
  <Border x:Name="Inspector" Grid.Column="1" Grid.RowSpan="4" Width="365" HorizontalAlignment="Right" Visibility="Collapsed" Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1,0,0,0" Padding="24"><ScrollViewer><StackPanel Spacing="20"><Grid><TextBlock Text="应用详情" FontSize="12" Foreground="{ThemeResource MutedBrush}"/><Button x:Name="CloseInspector" HorizontalAlignment="Right" Padding="8,4" Content="✕"/></Grid><StackPanel Spacing="7"><Image x:Name="DetailIcon" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,5"/><TextBlock x:Name="DetailKind" FontSize="11" Foreground="{ThemeResource AccentBrush}"/><TextBlock x:Name="DetailName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="DetailPath" Style="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel><Border Background="{ThemeResource RaisedBrush}" CornerRadius="12" Padding="18"><StackPanel Spacing="7"><TextBlock Text="当日点击" Style="{StaticResource Muted}"/><TextBlock x:Name="DetailTotal" Style="{StaticResource Metric}"/><TextBlock x:Name="DetailComparison" FontSize="11" Foreground="{ThemeResource AccentBrush}"/></StackPanel></Border><TextBlock x:Name="DetailShare" FontSize="12"/><StackPanel Spacing="12"><TextBlock Text="每日趋势" FontSize="14" FontWeight="SemiBold"/><Canvas x:Name="DetailChart" Height="135" HorizontalAlignment="Stretch"/><TextBlock x:Name="DetailPeriod" Style="{StaticResource Muted}"/></StackPanel><StackPanel Spacing="12"><TextBlock Text="按键明细" FontSize="14" FontWeight="SemiBold"/><StackPanel x:Name="DetailButtons" Spacing="12"/></StackPanel><TextBlock x:Name="DetailWheel" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
  </Grid>
</Grid>
